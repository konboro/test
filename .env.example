# ---------------------------------------------------------------------------
# lefta.app — environment
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL. Used to build the /pay links that go out in reminders.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Encryption ------------------------------------------------------------
# Wraps the myDATA subscription key at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<32-byte-base64-key>

# --- Stripe ----------------------------------------------------------------
# The platform account. Used to sell SMS credit packs and to run the Connect
# handshake. Invoice payments are NOT charged here — they are direct charges on
# each tenant's own connected account, so no customer money ever settles to
# lefta.
STRIPE_SECRET_KEY=sk_test_...

# Stripe → Settings → Connect → OAuth. Required for tenants to link their
# account; without it the payment button never appears for anyone.
STRIPE_CONNECT_CLIENT_ID=ca_...

# Endpoint secret for events on the PLATFORM account (SMS credit purchases).
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Endpoint secret for events on CONNECTED accounts (invoice payments,
# account.updated). Only needed if you configured a second endpoint; a single
# endpoint with "listen to events on connected accounts" enabled shares one
# secret and this can stay unset.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) --------------------------------------------------------
# Omit outside production to run the workflow in dry-run mode (messages logged,
# not sent).
RESEND_API_KEY=re_...

# The address reminders are sent from. May be a bare address or carry a
# display name; either way the creditor’s own company name is used as the
# display name per message, so a reminder reads as coming from them while the
# envelope stays on the domain that actually has SPF and DKIM.
#
# Until a domain is verified in Resend, onboarding@resend.dev is the only
# usable sender and it can only deliver to your own Resend account address.
EMAIL_FROM=noreply@lefta.app

# --- SMS (Brevo) -----------------------------------------------------------
# Omit outside production for dry-run mode.
# Brevo console → Settings → SMTP & API → API Keys (a v3 key, starts `xkeysib-`).
BREVO_API_KEY=xkeysib-...
# Sender shown on the handset. Brevo allows 11 alphanumeric characters; Greek
# operators block generic names such as INFO, SMS or NOTICE.
SMS_SENDER_ID=lefta

# --- Testing escape hatch ---------------------------------------------------
# Set to exactly 1 to lift the one-contact-per-debtor-per-day limit for MANUAL
# reminders, so the same test message can be sent repeatedly while delivery is
# being set up. The automated sweep keeps every lock it has.
#
# Leave unset in normal operation. Deleting the variable restores the guarantee
# immediately — there is no migration to undo. While it is on, the invoice list
# shows a banner so it cannot be left running unnoticed.
# UNSAFE_DISABLE_CONTACT_LIMITS=1

# --- Cron ------------------------------------------------------------------
# Shared secret for POST/GET /api/cron/dunning.
# Generate with: openssl rand -hex 32
CRON_SECRET=<random-secret>
