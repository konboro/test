# ---------------------------------------------------------------------------
# lefta.app — environment
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL. Used to build the /pay links that go out in reminders.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Encryption ------------------------------------------------------------
# Wraps the myDATA subscription key at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<32-byte-base64-key>

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) --------------------------------------------------------
# Omit outside production to run the workflow in dry-run mode (messages logged,
# not sent).
RESEND_API_KEY=re_...
EMAIL_FROM="lefta.app <noreply@your-domain.gr>"

# --- SMS (Twilio) ----------------------------------------------------------
# Omit either value outside production to run in dry-run mode (messages logged,
# not sent). Both come from the Twilio console dashboard.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=<auth token>
# Alphanumeric sender, up to 11 Latin characters. Greece needs no sender-ID
# pre-registration, but operators block generic names (INFO, SMS, NOTICE).
SMS_SENDER_ID=lefta

# --- Cron ------------------------------------------------------------------
# Shared secret for POST/GET /api/cron/dunning.
# Generate with: openssl rand -hex 32
CRON_SECRET=<random-secret>
