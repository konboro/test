    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.1.1",
    "stripe": "^17.5.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4.0.0",
